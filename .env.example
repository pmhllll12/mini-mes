# 자연어 질의(POST /query)용 설정 - 이 파일을 .env로 복사해 값을 채운다.
# .env는 .gitignore 대상이라 커밋되지 않는다. 키가 없으면 /query만 503으로 비활성되고 나머지 API는 그대로 동작한다.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# 두 키가 모두 있을 때 기본 제공자 (claude | gemini). 비우면 claude. 요청 본문의 provider가 우선한다.
NLQ_PROVIDER=

# 모델 (비우면 기본값: claude-opus-5 / gemini-flash-latest)
CLAUDE_MODEL=
GEMINI_MODEL=

# OpenAI 호환 API (NLQ_PROVIDER=openai_compat). 로컬 Ollama 예시 - 키 없이 동작, 외부 전송 없음
# OPENAI_COMPAT_BASE_URL=http://host.docker.internal:11434/v1
# OPENAI_COMPAT_MODEL=qwen2.5:7b-instruct   (qwen3:4b는 도구 호출을 텍스트로 출력해 실패 - docs/nlq.md)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_MODEL=
OPENAI_COMPAT_API_KEY=
# 로컬 모델은 첫 로딩이 느려 60초를 넘길 수 있음
NLQ_TIMEOUT_SEC=

# Grafana 알림 수신처 (Discord 채널 설정 > 연동 > 웹후크 URL). 비우면 알림 규칙은 평가·표시되고 발송만 실패
DISCORD_WEBHOOK_URL=

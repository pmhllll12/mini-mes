    "zero dns quotas in tenancy",
    "zero email-delivery quotas in tenancy",
    "zero kms quotas in tenancy",
    "zero streaming quotas in tenancy",
    "zero oci-kafka quotas in tenancy",
    "zero queue quotas in tenancy",
    "zero analytics quotas in tenancy",
    "zero big-data quotas in tenancy",
    "zero data-flow quotas in tenancy",
    "zero data-integration quotas in tenancy",
    "zero data-catalog quotas in tenancy",
    "zero data-science quotas in tenancy",
    "zero data-labeling quotas in tenancy",
    "zero datalake quotas in tenancy",
